# ============================================================
# ANS Management Platform — Environment Variables
# Copy to .env and fill in actual values
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="ANS Management Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=ans_platform
POSTGRES_USER=ans_user
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgresql+asyncpg://ans_user:change_me_postgres@localhost:5432/ans_platform

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=ans_rabbit
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_URL=amqp://ans_rabbit:change_me_rabbitmq@localhost:5672/

# ── MinIO (S3-compatible storage) ───────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=ans_minio
MINIO_ROOT_PASSWORD=change_me_minio_at_least_8_chars
MINIO_USE_SSL=false

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=oniverse
KEYCLOAK_CLIENT_ID=ans-frontend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak

# ── Microsoft Entra ID (Outlook OAuth) ──────────────────────
# Register at: https://portal.azure.com → App registrations
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://ans_rabbit:change_me_rabbitmq@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email Polling ───────────────────────────────────────────
EMAIL_POLL_INTERVAL_SECONDS=120
EMAIL_BATCH_SIZE=50

# ── Confidence Scoring ──────────────────────────────────────
CONFIDENCE_AUTO_COMMIT_THRESHOLD=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.60
