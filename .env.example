# ============================================================
# ANS Management Platform — Environment Variables
# ============================================================
# Copy to .env and fill in actual values.
# Variables marked (REQUIRED) must be set before first run.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="ANS Management Platform"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── PostgreSQL (REQUIRED) ──────────────────────────────────
POSTGRES_DB=ans_platform
POSTGRES_USER=ans_user
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgresql+asyncpg://ans_user:change_me_postgres@localhost:5432/ans_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
SQL_ECHO=false

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ── RabbitMQ (REQUIRED) ────────────────────────────────────
RABBITMQ_USER=ans_rabbit
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_URL=amqp://ans_rabbit:change_me_rabbitmq@localhost:5672/

# ── MinIO — S3-compatible storage (REQUIRED) ────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=ans_minio
MINIO_ROOT_PASSWORD=change_me_minio_at_least_8_chars
MINIO_SECURE=false

# ── Keycloak — Identity Provider (REQUIRED) ─────────────────
# Realm config lives in docker/keycloak/realm-oniverse.json (see
# docker/keycloak/README.md). Generate secrets with:  openssl rand -base64 32
#
# Keycloak's own database (created by docker/postgres/02-keycloak-db.sh)
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db
# Public address of Keycloak as the browser sees it (no trailing slash)
#   dev:  http://localhost:8080/auth      prod: https://<portal-host>/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
# Public address of the portal (allowed login redirect)
#   dev:  http://localhost:3000           prod: https://<portal-host>
PORTAL_URL=http://localhost:3000
# Keycloak console admin for FIRST START ONLY. After creating named admins
# (with OTP) in the master realm, delete this account.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me_keycloak_admin
# Secret of the "ans-backend" client (used by the backend in Phase 2+)
KEYCLOAK_CLIENT_SECRET=change_me_backend_client_secret
# Used by the backend today (replaced by KEYCLOAK_PUBLIC_URL /
# KEYCLOAK_INTERNAL_URL in Phase 2)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=oniverse
KEYCLOAK_CLIENT_ID=ans-backend

# ── Keycloak email (setup + "forgot password" emails) ───────
# Dev: leave as-is, every email lands in Mailpit (http://localhost:8025).
# Prod: the system mailbox, once Outlook vs Gmail is decided:
#   Gmail (Google Workspace): HOST=smtp.gmail.com PORT=587 STARTTLS=true
#     AUTH=true USER=<mailbox> SECRET=<app password>
#   Outlook (Microsoft 365): HOST=smtp.office365.com PORT=587 STARTTLS=true
#     uses token (XOAUTH2) auth, configured in the realm's Email tab;
#     see docker/keycloak/README.md
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=noreply@localhost
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_SECRET=

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost"]

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://ans_rabbit:change_me_rabbitmq@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email Polling ───────────────────────────────────────────
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
EMAIL_POLL_INTERVAL=5
EMAIL_POLL_INTERVAL_SECONDS=5
EMAIL_BATCH_SIZE=50

# ── IMAP — Inbound Email (REQUIRED for email engine) ───────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=sirio.asn.dev@gmail.com
IMAP_PASSWORD=something_you_should_hide
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true

# ── SMTP — Outbound Email (Wasthitha's part) ───────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-test-email@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_USE_TLS=true

# ── Nginx ───────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Microsoft Entra ID (Outlook OAuth — optional) ──────────
# Register at: https://portal.azure.com → App registrations
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
